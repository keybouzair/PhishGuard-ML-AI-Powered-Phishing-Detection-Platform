# ─────────────────────────────────────────────────────────────
# PhishGuard-ML — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────
FLASK_DEBUG=False
SECRET_KEY=replace-me-with-a-long-random-string
DATABASE_PATH=phishing_detection.db
MODEL_PATH=model/phishingdetection.pkl
CONFIDENCE_THRESHOLD=0.7

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Threat Intelligence APIs (optional) ──────────────────────
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# ── SMTP / Email ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Splunk / SIEM (optional) ─────────────────────────────────
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_URL=

# ── LLM Provider (optional) ──────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
