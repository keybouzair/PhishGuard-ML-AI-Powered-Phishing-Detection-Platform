# ─────────────────────────────────────────────────────────────
# PhishGuard-ML — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────
FLASK_DEBUG=False
SECRET_KEY=replace-me-with-a-long-random-string
DATABASE_PATH=phishing_detection.db
MODEL_PATH=model/phishingdetection.pkl
CONFIDENCE_THRESHOLD=0.7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app
ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Threat Intelligence APIs (optional) ──────────────────────
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# ── SMTP / Email ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Splunk / SIEM (optional) ─────────────────────────────────
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_URL=

# ── LLM Provider (optional) ──────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# ── Feature Flags & Toggles ────────────────────────────────────
FEATURE_THREAT_INTEL=True
FEATURE_ANALYTICS=True
FEATURE_EMAIL=True
FEATURE_ADVANCED_ML=True
FEATURE_SECURITY=True
FEATURE_INTEGRATIONS=True
FEATURE_2FA=True
ENABLE_ACTIVE_DEFENSE=True
ENABLE_PHISHING_SIMULATOR=True

# ── Slack / Teams / SIEM Integrations (optional) ──────────────
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts
TEAMS_WEBHOOK_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=phishing-alerts

# ── Email Alerts Configuration (optional) ──────────────────────
EMAIL_ALERTS_ENABLED=True
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@phishing-detector.local
